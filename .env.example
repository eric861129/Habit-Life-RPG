# Local development database. Chapter 8 replaces this with Azure SQL.
DATABASE_URL=sqlite:///./habit_life_rpg.db

# Replace this value in .env. Never commit the real secret.
HLR_JWT_SECRET=replace-with-a-long-random-secret
HLR_ACCESS_TOKEN_MINUTES=60

# Dates and daily check-ins use this application timezone.
HLR_APP_TIMEZONE=Asia/Taipei

# Comma-separated browser origins. Add the deployed frontend in Chapter 8.
HLR_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HLR_ENVIRONMENT=development

# Frontend API root. Chapter 8 replaces this with Azure App Service.
VITE_API_BASE_URL=http://localhost:8000
