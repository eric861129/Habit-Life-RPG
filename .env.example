# Local development database. App Service uses the four Azure SQL fields below instead.
DATABASE_URL=sqlite:///./habit_life_rpg.db
# DATABASE_HOST=replace-me.database.windows.net
# DATABASE_NAME=habit-life-rpg
# DATABASE_USER=hlradmin
# DATABASE_PASSWORD=replace-with-a-secret

# Replace this value in .env. Never commit the real secret.
HLR_JWT_SECRET=replace-with-a-long-random-secret
HLR_ACCESS_TOKEN_MINUTES=60

# Dates and daily check-ins use this application timezone.
HLR_APP_TIMEZONE=Asia/Taipei

# Comma-separated browser origins. Production must contain only the deployed frontend origin.
HLR_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HLR_ENVIRONMENT=development

# Optional demo seed. Replace the password in .env before running the seed command.
HLR_DEMO_USERNAME=book-demo
HLR_DEMO_PASSWORD=replace-with-a-demo-password

# Frontend API root. Azure Static Web Apps receives this value during its build.
VITE_API_BASE_URL=http://localhost:8000
